#!/bin/sh
# Lab-only poison injector for the quarantine drill: puts one raw message,
# byte-for-byte as given, on the worker input queue.
# Usage: scripts/poison <runTag> <rawBody> — see tools/Poison.java and
# docs/RUNBOOK-L3.md. MQ client jars resolve from the local Maven cache.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/scripts/java-env.sh"
MQ_JAR=$(find "$ROOT/.cache/repository" -name 'com.ibm.mq.jakarta.client-*.jar' | head -1)
JMS_JAR=$(find "$ROOT/.cache/repository" -name 'jakarta.jms-api-*.jar' | head -1)
if [ -z "$MQ_JAR" ] || [ -z "$JMS_JAR" ]; then echo "run ./mvnw -q test-compile first (populates .cache/repository)" >&2; exit 1; fi
exec "$JAVA_HOME/bin/java" -cp "$MQ_JAR:$JMS_JAR" "$ROOT/tools/Poison.java" "$@"
