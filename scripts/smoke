#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/scripts/java-env.sh"
cd "$ROOT"
# Build only: the suite runs in gate 1 (and standalone mvnw), never as a side
# effect here — re-running it on a smoke-dirty lab once broke WorkerTest's
# global reconcile counts (smoke leaves open tasks by design).
./mvnw -q package -DskipTests
exec python3 "$ROOT/scripts/smoke.py"
