#!/bin/sh
# Core scenario suite launcher (SC01-SC12): packages the app, then runs the
# acceptance catalog against the local lab. Requires Postgres + MQ up.
# See scripts/scenarios.py for the assertions and reports.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/scripts/java-env.sh"
cd "$ROOT"
# Build only: the suite runs in gate 1 (and standalone mvnw), never as a side
# effect here — re-running it on a dirty lab once broke WorkerTest's global
# reconcile counts (SC09 leaves open tasks by design).
./mvnw -q package -DskipTests
exec python3 "$ROOT/scripts/scenarios.py"
