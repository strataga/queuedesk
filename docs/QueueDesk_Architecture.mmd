%% QueueDesk target architecture v1.2
%% Proposed design only. All instructions and outcomes are synthetic.
%% Solid edges are application flow; dotted edges are diagnostic telemetry.
%% The full observability stack is optional. Start with local JSON logs and Actuator.
flowchart TB
  subgraph APP["Application flow"]
    GEN["1 Java CLI generator<br/>Seeded synthetic instructions"]
    API["2 Spring Boot API<br/>Validation and idempotency"]
    DB[("3 PostgreSQL<br/>Instructions, outbox, dedup and durable audit")]
    PUB["4 Outbox publisher<br/>Stable eventId on retry"]
    MQ["5 IBM MQ<br/>Persistent messages and redelivery"]
    WORKER["6 Worker<br/>Consume and deduplicate"]
    RISK["7 Optional L5 risk gate<br/>Java features, rules and policy<br/>Mock first, Jev only after setup"]
    MOCK["8 Mock clearing and receiving bank<br/>Simulated outcome only"]
    HELD["RISK_HELD<br/>Unknown or failed assessment"]
    REJECT["REJECTED<br/>Explicit simulation policy only"]
    DASH["Read-only Angular dashboard<br/>Later"]
    GEN -->|HTTP| API
    API -->|One admission transaction| DB
    DB -->|Pending outbox| PUB
    PUB -->|Persistent event| MQ
    MQ -->|Each delivery attempt| WORKER
    WORKER -->|Risk mode enabled| RISK
    WORKER -->|Risk mode OFF| MOCK
    RISK -->|ALLOW only| MOCK
    RISK -->|Review or not assessed| HELD
    RISK -->|Explicit reject| REJECT
    MOCK -->|Commit outcome, dedup and audit| DB
    HELD -->|Commit hold, handled marker and audit| DB
    REJECT -->|Commit rejection, handled marker and audit| DB
    DASH -->|GET status| API
  end
  subgraph OBS["Telemetry side path - optional backends"]
    LOCAL["Start small<br/>Structured JSON logs + Actuator/Micrometer"]
    COLLECTOR["OpenTelemetry Collector<br/>Later; bounded queues and export timeouts"]
    PROM["Prometheus<br/>Optional metrics history"]
    TEMPO["Tempo<br/>Optional traces"]
    LOKI["Loki<br/>Optional centralized logs"]
    GRAFANA["Grafana<br/>Operational views"]
    LOCAL -.->|OTLP when configured| COLLECTOR
    LOCAL -.->|Metrics scrape when enabled| PROM
    COLLECTOR -.->|Metrics exporter when configured| PROM
    COLLECTOR -.->|Traces| TEMPO
    COLLECTOR -.->|Logs when configured| LOKI
    PROM -.-> GRAFANA
    TEMPO -.-> GRAFANA
    LOKI -.-> GRAFANA
  end
  API -.-> LOCAL
  PUB -.-> LOCAL
  WORKER -.-> LOCAL
  RISK -.-> LOCAL
  MQ -.->|Authorized queue monitor or labeled estimate| LOCAL
  %% Jev confidence is not fraud probability. Fraud accuracy needs independent labels.
  %% Persist context at the outbox boundary and verify MQ propagation/redelivery.
  %% Telemetry outages must not block processing. Durable audit is not sampled telemetry.
